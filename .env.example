# Development Environment Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading_bot
REDIS_URL=redis://localhost:6379/0

# Interactive Brokers Configuration
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Security (change in production)
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Backtesting Configuration
BACKTEST_DATA_PATH=/workspace/data
MAX_BACKTEST_YEARS=5

# Redis Keys
PRICE_DATA_KEY_PREFIX=price:
PORTFOLIO_KEY_PREFIX=portfolio:
SIGNALS_KEY_PREFIX=signals:
